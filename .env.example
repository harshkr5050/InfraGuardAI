# Local example (Docker MySQL in docker-compose.yml)
DATABASE_URL=mysql://infraguard:infraguard123@127.0.0.1:3306/infraguard

# Set true only if your cloud MySQL provider requires TLS.
DB_SSL=false

# Optional: change demo login credentials by changing the seeded database row.
# Default login after first boot:
# admin@infraguard.ai / demo123

# Used to sign 12-hour demo admin sessions. Change this in production.
APP_SECRET=replace-with-a-long-random-secret
